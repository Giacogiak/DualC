#!/bin/sh
# DualC local gate -- the fast tier only (build + ctest are minutes, and belong
# to the explicit `python scripts/check.py`). Enable once per clone with:
#     git config core.hooksPath scripts/hooks
# Bypass a single commit with:  git commit --no-verify
# python3 where it exists (Linux has no `python`), python otherwise (Windows).
PY=$(command -v python3 || command -v python)
exec "$PY" "$(git rev-parse --show-toplevel)/scripts/check.py" --fast
